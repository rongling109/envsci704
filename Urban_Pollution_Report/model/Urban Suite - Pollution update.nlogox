<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[; Common educational model base for Experiments 1 and 2.
; Adapted from Urban Suite - Pollution, Uri Wilensky (2007).
; Preserve the original attribution and license in the Info tab.
;
; These variables are created by Interface sliders:
; power-plants, polluting-rate, planting-rate,
; wind-strength, wind-direction.
;
; Pollution, distance and ticks use abstract model units.
globals [
  preplant-mean-pollution
  preplant-max-pollution
]

breed [ trees tree ]

patches-own [
  pollution
  is-power-plant?
  next-pollution
]


; ============================================
; 1. INITIALIZATION
; ============================================

to setup
  clear-all

  if power-plants < 0 or power-plants > count patches [
    error "power-plants must be between 0 and the number of patches."
  ]

  if power-plants != floor power-plants [
    error "power-plants must be an integer."
  ]

  if polluting-rate < 0 or planting-rate < 0 [
    error "polluting-rate and planting-rate must be non-negative."
  ]

  if wind-strength < 0 or wind-strength > 1 [
    error "wind-strength must be between 0 and 1."
  ]

  if not member? wind-direction [0 90 180 270] [
    error "Use wind-direction 0, 90, 180 or 270."
  ]

  set-default-shape trees "tree"

  ask patches [
    set pollution 0
    set next-pollution 0
    set is-power-plant? false
  ]

  ask n-of power-plants patches [
    set is-power-plant? true
  ]

  update-display
  reset-ticks
end


; ============================================
; 2. ONE MODEL TICK
; ============================================

to go
  council-plant
  emit-pollution

  diffuse pollution 0.8
  transport-by-wind

  ask trees [
    cleanup
  ]

  update-display
  tick
end


; ============================================
; 3. CONTINUOUS POLLUTION EMISSIONS
; ============================================

to emit-pollution
  ask patches with [ is-power-plant? ] [
    set pollution pollution + polluting-rate
  ]
end


; ============================================
; 4. COUNCIL CONTINUOUS PLANTING
; ============================================

; planting-rate:
; expected number of NEW trees per tick.
;
; Fractional values use stochastic rounding.
; Example: 0.5 gives a 50% chance of one new tree.
;
; One tree per patch; no trees on source patches.

to council-plant
  if planting-rate = 0 [
    stop
  ]

  let available patches with [
    not is-power-plant? and not any? trees-here
  ]

  if not any? available [
    stop
  ]

  let number-to-plant floor planting-rate
  let fractional-part planting-rate - number-to-plant

  if fractional-part > 0 [
    if random-float 1 < fractional-part [
      set number-to-plant number-to-plant + 1
    ]
  ]

  set number-to-plant
    min (list number-to-plant count available)

  if number-to-plant > 0 [
    ask n-of number-to-plant available [
      sprout-trees 1 [
        set color green
        set size 1
      ]
    ]
  ]
end


; ============================================
; 5. SIMPLIFIED WIND TRANSPORT
; ============================================

; wind-strength:
; fraction of pollution transported one patch per tick.
;
; wind-direction:
; direction pollution travels TOWARDS.
; 0 = north, 90 = east, 180 = south, 270 = west.
;
; A buffer prevents repeated transport within one tick.
; With wrapping OFF, pollution leaving the world is lost.

to transport-by-wind
  if wind-strength = 0 [
    stop
  ]

  ask patches [
    set next-pollution pollution * (1 - wind-strength)
  ]

  ask patches [
    let transported pollution * wind-strength

    let destination
      patch-at-heading-and-distance wind-direction 1

    if destination != nobody [
      ask destination [
        set next-pollution next-pollution + transported
      ]
    ]
  ]

  ask patches [
    set pollution next-pollution
  ]
end


; ============================================
; 6. TREE POLLUTION CLEANUP
; ============================================

; Original cleanup capacities:
; 1 unit on the tree's patch;
; 0.5 units on each neighboring patch.
;
; Trees have no health, growth or death.

to cleanup
  ask patch-here [
    set pollution max (list 0 (pollution - 1))

    ask neighbors [
      set pollution max (list 0 (pollution - 0.5))
    ]
  ]
end


; ============================================
; 7. DISPLAY
; ============================================

; Display does not change pollution values.

to update-display
  ask patches [
    set pcolor scale-color red (pollution - 0.1) 5 0

    if is-power-plant? [
      set pcolor red
    ]

    if any? trees-here [
      set pcolor green + 3
    ]
  ]
end


; ============================================
; 8. OUTPUT REPORTERS
; ============================================

to-report mean-pollution
  report mean [ pollution ] of patches
end

to-report max-pollution
  report max [ pollution ] of patches
end

to-report total-pollution
  report sum [ pollution ] of patches
end

; Export the pollution and locations of all patches.
to export-spatial-data [output-file]
  ; Re-running replaces the same spatial output file.
  if file-exists? output-file [
    file-delete output-file
  ]

  file-open output-file
  file-print "x,y,pollution,is_source,tree_count,tick,wind_strength,wind_direction"

  foreach sort patches [ p ->
    file-print (word
      [pxcor] of p ","
      [pycor] of p ","
      [pollution] of p ","
      [is-power-plant?] of p ","
      [count trees-here] of p ","
      ticks ","
      wind-strength ","
      wind-direction)
  ]

  file-close
end


; Generate eight spatial snapshots for Experiment 2.
to run-wind-spatial-demo
  let output-folder user-directory
  if output-folder = false [ stop ]

  set power-plants 2
  set polluting-rate 0.1
  set planting-rate 0
  set wind-direction 90

  foreach [0 0.2] [ strength ->
    set wind-strength strength
    random-seed 1001
    setup

    repeat 100 [
      go

      if member? ticks [10 30 60 100] [
        let output-file (word output-folder
          "wind_" strength "_tick_" ticks ".csv")

        export-spatial-data output-file
      ]
    ]
  ]

  print "Done: eight spatial CSV files exported."
end

; ============================================
; 9. EXPERIMENT 3: COMMON WARMUP AND FIXED BUDGET
; ============================================

to setup-strategy-experiment
  ; Disable continuous planting.
  set planting-rate 0
  setup

  if not member? planting-strategy
    ["random" "source-targeted" "high-pollution"] [
    error "Unknown planting strategy."
  ]

  if tree-budget < 0 or tree-budget != floor tree-budget [
    error "tree-budget must be a non-negative integer."
  ]

  let available patches with [
    not is-power-plant? and not any? trees-here
  ]

  if tree-budget > count available [
    error "Not enough available patches for this tree budget."
  ]

  if planting-strategy = "source-targeted"
    and not any? patches with [is-power-plant?] [
    error "Source-targeted planting requires a pollution source."
  ]

  ; All strategies start with the same no-tree warmup.
  repeat 30 [
    go
  ]

  set preplant-mean-pollution mean-pollution
  set preplant-max-pollution max-pollution

  ; Plant once, at tick 30.
  plant-fixed-budget
  update-display
end


; ============================================
; 10. THREE LOCATION STRATEGIES
; ============================================

to plant-fixed-budget
  if tree-budget = 0 [ stop ]

  ; Prevent accidental repeated deployment.
  if any? trees [
    error "Fixed-budget planting requires an empty tree population."
  ]

  let available patches with [
    not is-power-plant? and not any? trees-here
  ]

  if tree-budget > count available [
    error "Not enough available patches."
  ]

  let selected no-patches

  ; Baseline: random locations.
  if planting-strategy = "random" [
    set selected n-of tree-budget available
  ]

  ; Prioritise patches nearest to either pollution source.
  if planting-strategy = "source-targeted" [
    let sources patches with [is-power-plant?]

    if not any? sources [
      error "No pollution sources found."
    ]

    set selected min-n-of tree-budget available [
      min [distance myself] of sources
    ]
  ]

  ; Prioritise current pollution hotspots.
  ; All sites are selected before any trees clean pollution.
  if planting-strategy = "high-pollution" [
    set selected max-n-of tree-budget available [
      pollution
    ]
  ]

  if count selected != tree-budget [
    error "Planting strategy did not select the required tree budget."
  ]

  ask selected [
    sprout-trees 1 [
      set color green
      set size 1
    ]
  ]
end]]></code>
  <widgets>
    <view x="307" wrappingAllowedX="false" y="13" frameRate="30.0" minPycor="-31" height="445" showTickCounter="true" patchSize="7.0" fontSize="10" wrappingAllowedY="false" width="501" tickCounterLabel="years" maxPycor="31" updateMode="1" maxPxcor="35" minPxcor="-35"></view>
    <button x="87" y="1" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="55" display="go">go</button>
    <button x="25" y="2" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="setup">setup</button>
    <slider x="24" step="0.05" y="50" max="1" width="250" display="wind-strength" height="50" min="0" direction="Horizontal" default="0.2" variable="wind-strength"></slider>
    <slider x="22" step="90" y="111" max="270" width="250" display="wind-direction" height="50" min="0" direction="Horizontal" default="90.0" variable="wind-direction"></slider>
