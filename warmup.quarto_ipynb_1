   "source": [
    "# Simulate 10 days of exponential population growth\n",
    "\n",
    "population = 100\n",
    "rate = 0.05\n",
    "history = [population]\n",
    "\n",
    "for day in range(10):\n",
    "    population = population + rate * population\n",
    "    history.append(round(population, 1))\n",
    "\n",
    "print(history)"
