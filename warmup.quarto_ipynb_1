    "import matplotlib.pyplot as plt\n",
    "\n",
    "concentration = 100.0\n",
    "decay_rate = 0.1\n",
    "dt = 1.0\n",
    "tracer_history = [concentration]\n",
    "\n",
    "for day in range(60):\n",
    "    concentration = concentration - decay_rate * concentration * dt\n",
    "    tracer_history.append(concentration)\n",
    "\n",
    "plt.plot(tracer_history)\n",
    "plt.xlabel(\"Day\")\n",
    "plt.ylabel(\"Concentration (mg/L)\")\n",
    "plt.title(\"Tracer decay in a lake\")\n",
    "plt.show()"
